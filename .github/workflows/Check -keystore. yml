name: Check Existing Sakay Na Keystore

on:
  workflow_dispatch:

jobs:
  check:
    runs-on: ubuntu-latest

    steps:
      - name: Restore existing keystore
        env:
          KEYSTORE_BASE64: ${{ secrets.SAKAYNA_KEYSTORE_BASE64 }}
        run: |
          echo "$KEYSTORE_BASE64" | base64 --decode > sakayna-release.jks

      - name: Check keystore with KEYSTORE_PASSWORD
        env:
          STORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
        run: |
          if keytool -list \
            -keystore sakayna-release.jks \
            -storepass "$STORE_PASSWORD" > /dev/null 2>&1
          then
            echo "STORE_PASSWORD: VALID"
          else
            echo "STORE_PASSWORD: INVALID"
            exit 1
          fi

      - name: Check key with KEYSTORE_PASSWORD
        env:
          STORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
        run: |
          if keytool -list \
            -keystore sakayna-release.jks \
            -storepass "$STORE_PASSWORD" \
            -alias "$KEY_ALIAS" \
            -keypass "$STORE_PASSWORD" > /dev/null 2>&1
          then
            echo "KEY_PASSWORD = KEYSTORE_PASSWORD: VALID"
          else
            echo "KEY_PASSWORD = KEYSTORE_PASSWORD: INVALID"
          fi

      - name: Check key with original Create-keystore password
        env:
          STORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
        run: |
          if keytool -list \
            -keystore sakayna-release.jks \
            -storepass "$STORE_PASSWORD" \
            -alias "$KEY_ALIAS" \
            -keypass 'SakayNa123!' > /dev/null 2>&1
          then
            echo "KEY_PASSWORD = original Create-keystore password: VALID"
          else
            echo "KEY_PASSWORD = original Create-keystore password: INVALID"
          fi
