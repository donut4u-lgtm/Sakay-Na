rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // CONFIRMED SAKAY NA ADMIN UID
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == "Ld3rzaCvAGNlXBDCofB3mWjgXWp2";
    }

    match /users/{userId} {

      // Users can create their own profile.
      allow create: if request.auth != null
                    && request.auth.uid == userId;

      // User can read own profile.
      // Confirmed Admin can read all user profiles.
      allow read: if request.auth != null
                  && (
                    request.auth.uid == userId
                    || isAdmin()
                  );

      // User can update own profile.
      // Confirmed Admin can update user profiles.
      allow update: if request.auth != null
                    && (
                      request.auth.uid == userId
                      || isAdmin()
                    );
    }

    match /rides/{rideId} {

      // Existing Sakay Na ride access.
      allow read, write: if request.auth != null;

      // CHAT MESSAGES FOR THIS RIDE
      //
      // Only the passenger or driver assigned to this ride
      // can read or create chat messages.
      match /messages/{messageId} {

        allow read: if request.auth != null
                    && (
                      request.auth.uid == get(
                        /databases/$(database)/documents/rides/$(rideId)
                      ).data.passengerId
                      ||
                      request.auth.uid == get(
                        /databases/$(database)/documents/rides/$(rideId)
                      ).data.driverId
                      ||
                      isAdmin()
                    );

        allow create: if request.auth != null
                      && (
                        request.auth.uid == get(
                          /databases/$(database)/documents/rides/$(rideId)
                        ).data.passengerId
                        ||
                        request.auth.uid == get(
                          /databases/$(database)/documents/rides/$(rideId)
                        ).data.driverId
                        ||
                        isAdmin()
                      )
                      && request.resource.data.senderId == request.auth.uid;

        allow update, delete: if isAdmin();
      }
    }

    match /driverLocations/{driverId} {
      allow read, write: if request.auth != null;
    }
  }
}
