
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && request.auth.uid == "Ld3rzaCvAGNlXBDCofB3mWjgXWp2";
    }

    function isDriver() {
      return request.auth != null
             && (
               exists(
                 /databases/$(database)/documents/drivers/$(request.auth.uid)
               )
               ||
               (
                 exists(
                   /databases/$(database)/documents/users/$(request.auth.uid)
                 )
                 &&
                 get(
                   /databases/$(database)/documents/users/$(request.auth.uid)
                 ).data.get("driverProfileComplete", false) == true
               )
             );
    }

    match /users/{userId} {

      allow create: if request.auth != null
                    && request.auth.uid == userId;

      allow read: if request.auth != null
                  && (
                    request.auth.uid == userId
                    || isAdmin()
                  );

      allow update: if request.auth != null
                    && (
                      request.auth.uid == userId
                      || isAdmin()
                    );
    }

    match /drivers/{driverId} {

      allow read, write: if request.auth != null
                         && (
                           request.auth.uid == driverId
                           || isAdmin()
                         );
    }

    match /rides/{rideId} {

      allow read: if request.auth != null
                  && (
                    isAdmin()

                    || resource.data.get("passengerId", "")
                       == request.auth.uid

                    || resource.data.get("driverId", "")
                       == request.auth.uid

                    || (
                      isDriver()
                      && resource.data.get("status", "")
                         == "REQUESTED"
                    )
                  );

      allow create: if request.auth != null
                    && (
                      isAdmin()
                      || request.resource.data.get("passengerId", "")
                         == request.auth.uid
                    );

      allow update: if request.auth != null
                    && (
                      isAdmin()

                      || resource.data.get("passengerId", "")
                         == request.auth.uid

                      || resource.data.get("driverId", "")
                         == request.auth.uid

                      || (
                        isDriver()
                        && resource.data.get("status", "")
                           == "REQUESTED"
                        && resource.data.get("driverId", null) == null
                        && request.resource.data.get("driverId", "")
                           == request.auth.uid
                        && request.resource.data.get("status", "")
                           == "ACCEPTED"
                      )

                      || (
                        isDriver()
                        && resource.data.get("status", "")
                           == "REQUESTED"
                        && request.resource.data.get("status", "")
                           == "DECLINED"
                        && request.resource.data.get("declinedDriverId", "")
                           == request.auth.uid
                      )
                    );

      match /messages/{messageId} {

        allow read: if request.auth != null
                    && (
                      request.auth.uid == get(
                        /databases/$(database)/documents/rides/$(rideId)
                      ).data.get("passengerId", "")

                      ||

                      request.auth.uid == get(
                        /databases/$(database)/documents/rides/$(rideId)
                      ).data.get("driverId", "")

                      ||

                      isAdmin()
                    );

        allow create: if request.auth != null
                      && (
                        request.auth.uid == get(
                          /databases/$(database)/documents/rides/$(rideId)
                        ).data.get("passengerId", "")

                        ||

                        request.auth.uid == get(
                          /databases/$(database)/documents/rides/$(rideId)
                        ).data.get("driverId", "")

                        ||

                        isAdmin()
                      )
                      && request.resource.data.get("senderId", "")
                         == request.auth.uid;

        allow update, delete: if isAdmin();
      }
    }

    match /driverLocations/{driverId} {

      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && (
                     request.auth.uid == driverId
                     || isAdmin()
                   );
    }

    match /driverSettlements/{settlementId} {

      allow read: if request.auth != null
                  && (
                    isAdmin()
                    || resource.data.get("driverId", "")
                       == request.auth.uid
                  );

      allow create: if request.auth != null
                    && request.resource.data.get("driverId", "")
                       == request.auth.uid
                    && request.resource.data.get("status", "")
                       == "PENDING";

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }
  }
}
