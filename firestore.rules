
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // CONFIRMED SAKAY NA ADMIN UID
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == "Ld3rzaCvAGNlXBDCofB3mWjgXWp2";
    }

    // USER PROFILES
    match /users/{userId} {

      allow create: if request.auth != null
                    && request.auth.uid == userId;

      allow read: if request.auth != null
                  && (
                    request.auth.uid == userId
                    || isAdmin()
                  );

      allow update: if request.auth != null
                    && (
                      request.auth.uid == userId
                      || isAdmin()
                    );
    }

    // DRIVER PROFILES / DRIVER ONLINE STATUS
    match /drivers/{driverId} {

      // Driver can create/update/read their own driver document.
      // Admin can manage all driver documents.
      allow read, write: if request.auth != null
                         && (
                           request.auth.uid == driverId
                           || isAdmin()
                         );
    }

    // RIDES
    match /rides/{rideId} {

      // Existing Sakay Na ride access.
      allow read, write: if request.auth != null;

      // CHAT MESSAGES
      match /messages/{messageId} {

        allow read: if request.auth != null
                    && (
                      request.auth.uid == get(
                        /databases/$(database)/documents/rides/$(rideId)
                      ).data.passengerId
                      ||
                      request.auth.uid == get(
                        /databases/$(database)/documents/rides/$(rideId)
                      ).data.driverId
                      ||
                      isAdmin()
                    );

        allow create: if request.auth != null
                      && (
                        request.auth.uid == get(
                          /databases/$(database)/documents/rides/$(rideId)
                        ).data.passengerId
                        ||
                        request.auth.uid == get(
                          /databases/$(database)/documents/rides/$(rideId)
                        ).data.driverId
                        ||
                        isAdmin()
                      )
                      && request.resource.data.senderId
                         == request.auth.uid;

        allow update, delete: if isAdmin();
      }
    }

    // DRIVER GPS LOCATION
    match /driverLocations/{driverId} {

      allow read, write: if request.auth != null;
    }
  }
}
